# Enter secrets directly in Railway's Variables UI. Never commit actual values.
APP_BASE_URL=https://resumebuilder.shop
INTAKE_ENABLED=false
LAUNCH_APPROVED=false
# Mount one persistent Railway volume at /data; keep one service replica.
DATA_DIR=/data
DATA_ENCRYPTION_KEY=
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
# Optional dedicated private ClamAV service; Word/PDF uploads fail closed without it.
CLAMAV_HOST=
CLAMAV_PORT=3310
RETENTION_DAYS=30
MAX_AI_JOBS_PER_DAY=20
PACKAGE_PRICE_CENTS=9900
# No Stripe secrets or payment feature is used in this release.

# Optional advertising stays off until Google approval and certified consent setup.
ADSENSE_CLIENT=
ADSENSE_SLOT=
ADS_ENABLED=false
ADS_CONSENT_READY=false
